*.img
*.lst
*.scn
*.sav
*.npz
*.npy
*.nii
*.nii.gz
*.roi
*.ROI

# Python / Jupyter artifacts
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/
.pytest_cache/
*.egg-info/
.venv/
venv/

# OS / Editor metadata
.DS_Store
._*
Thumbs.db
*:AFP_Resource
